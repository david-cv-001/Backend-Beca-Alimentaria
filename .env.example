# App
APP_NAME=backend-beca-alimentaria
ENVIRONMENT=dev
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/beca_alimentaria
DATABASE_ECHO=false

# Auth (JWT propio)
JWT_SECRET_KEY=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=http://localhost:4200

# Biometry (DeepFace)
FACE_MODEL_NAME=Facenet512
FACE_DETECTOR_BACKEND=retinaface
FACE_DISTANCE_METRIC=cosine
FACE_THRESHOLD=0.32
FACE_ENFORCE_DETECTION=true
FACE_ALIGN=true

# Security (seed del primer superadmin)
FIRST_SUPERADMIN_USERNAME=superadmin
FIRST_SUPERADMIN_EMAIL=superadmin@beca.com
FIRST_SUPERADMIN_PASSWORD=admin123
